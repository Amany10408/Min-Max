# ComfyUI / MiniMax H3 on Vast.ai
#
# Recommended defaults for NVIDIA RTX PRO 6000 (96GB) / Blackwell + torch cu128:
#   PROFILE=standard  → FL2VA (text + image → video) with pruned BF16 + NVFP4 text encoder
# Set PROFILE=full to also download Ref2VA (reference image/video/audio → video).

# Where this repo lives after clone
export MINMAX_REPO_DIR="${MINMAX_REPO_DIR:-/workspace/Min-Max}"

# ComfyUI install location
export COMFYUI_DIR="${COMFYUI_DIR:-/workspace/ComfyUI}"
export COMFYUI_REF="${COMFYUI_REF:-v0.36.0}"

# Internal bind (Caddy proxies the public port)
export COMFYUI_HOST="${COMFYUI_HOST:-127.0.0.1}"
export COMFYUI_PORT="${COMFYUI_PORT:-18188}"

# Free Vast open port used as Caddy external_port (must have VAST_TCP_PORT_<n>)
export COMFYUI_EXTERNAL_PORT="${COMFYUI_EXTERNAL_PORT:-10100}"

# Model download profile: lite | standard | full
#   lite     = pruned FP8 FL2VA + NVFP4 TE (smaller disk, lower quality)
#   standard = pruned BF16 FL2VA + NVFP4 TE + turbo LoRA (best for 80–96GB)
#   full     = standard + Ref2VA pruned BF16
export PROFILE="${PROFILE:-standard}"

# Hugging Face model repo (ComfyUI-repacked weights)
export HF_REPO="${HF_REPO:-Comfy-Org/MiniMax-H3}"

# Optional: export HF_TOKEN=... for higher rate limits / gated assets
# Optional: export OPEN_BUTTON_TOKEN / WEB_PASSWORD already set by Vast for auth
